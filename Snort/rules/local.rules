# ============================================================
# NMAP -p OS PUERTOS - DEBUG
# ============================================================

# ETAPA 1 - SYN caracteristico observado en Nmap
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Estado interno SYN Nmap-like"; flags:S; window:1024; dsize:0; flowbits:set,soc.nmap.syn1024; flowbits:noalert; sid:1000001; rev:1;)

# ETAPA 2 - El servidor confirma que el puerto esta abierto
alert tcp 192.168.0.16 any -> any any (msg:"SOC DEKMA - Estado interno SYNACK Nmap-like"; flags:SA; dsize:0; flowbits:isset,soc.nmap.syn1024; flowbits:set,soc.nmap.synack; flowbits:noalert; sid:1000002; rev:1;)

# ETAPA 3 - Scanner aborta inmediatamente con RST
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap probable TCP SYN scan sobre puerto abierto"; flags:R; window:0; dsize:0; flowbits:isset,soc.nmap.syn1024&soc.nmap.synack; classtype:network-scan; sid:1000003; rev:1;)

# ============================================================
# NMAP -sT OS FINGERPRINTING - DEBUG
# ============================================================

alert tcp any any -> 192.168.0.16 any (msg:"STATE sT - SYN 64240"; flags:S; window:64240; dsize:0; flowbits:set,soc.st.syn; flowbits:noalert; sid:1000111; rev:2;)

alert tcp 192.168.0.16 any -> any any (msg:"STATE sT - SYNACK"; flags:SA; window:8192; dsize:0; flowbits:isset,soc.st.syn; flowbits:set,soc.st.synack; flowbits:noalert; sid:1000112; rev:2;)

alert tcp any any -> 192.168.0.16 any (msg:"STATE sT - ACK handshake"; flags:A; window:126; dsize:0; flowbits:isset,soc.st.syn&soc.st.synack; flowbits:set,soc.st.ack; flowbits:noalert; sid:1000113; rev:2;)

alert tcp any any -> 192.168.0.16 any (msg:"STATE sT - CANCEL payload cliente"; dsize:>0; flowbits:isset,soc.st.ack; flowbits:unset,soc.st.ack; flowbits:noalert; sid:1000114; rev:2;)

alert tcp 192.168.0.16 any -> any any (msg:"STATE sT - CANCEL payload servidor"; dsize:>0; flowbits:isset,soc.st.ack; flowbits:unset,soc.st.ack; flowbits:noalert; sid:1000115; rev:2;)

alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Probable Nmap TCP Connect Scan -sT"; flags:RA; window:126; dsize:0; flowbits:isset,soc.st.syn&soc.st.synack&soc.st.ack; classtype:network-scan; priority:3; sid:1000116; rev:2;)

# ============================================================
# SOC DEKMA - NMAP OS FINGERPRINTING (-O)
# Snort 2.9.20
# Destino protegido: 192.168.0.16
# ============================================================

# ECN - probe altamente caracteristico
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe ECN"; flags:SCE; window:3; dsize:0; classtype:network-scan; priority:2; sid:1000301; rev:2;)

# T2 - NULL + ventana 128
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe T2 NULL"; flags:0; window:128; dsize:0; classtype:network-scan; priority:2; sid:1000302; rev:2;)

# T3 - FIN SYN PSH URG + ventana 256
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe T3"; flags:FSPU; window:256; dsize:0; classtype:network-scan; priority:2; sid:1000303; rev:2;)

# T4 - ACK + ventana 1024
# AUXILIAR: falso positivo confirmado con nmap -sA y -sW.
# NO sera utilizado como indicador fuerte por Wazuh.
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe T4 ACK auxiliary"; flags:A; window:1024; dsize:0; classtype:network-scan; priority:3; sid:1000304; rev:2;)

# T5 - SYN + ventana 31337
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe T5"; flags:S; window:31337; dsize:0; classtype:network-scan; priority:2; sid:1000305; rev:2;)

# T6 - ACK + ventana 32768
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe T6"; flags:A; window:32768; dsize:0; classtype:network-scan; priority:2; sid:1000306; rev:2;)

# T7 - FIN PSH URG + ventana 65535
alert tcp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe T7"; flags:FPU; window:65535; dsize:0; classtype:network-scan; priority:2; sid:1000307; rev:2;)

# U1 - UDP 300 bytes
alert udp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe U1 UDP"; dsize:300; classtype:network-scan; priority:2; sid:1000308; rev:2;)

# IE1 - ICMP fingerprint
alert icmp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe IE1"; itype:8; icmp_seq:295; classtype:network-scan; priority:2; sid:1000309; rev:2;)

# IE2 - ICMP fingerprint
alert icmp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Nmap OS fingerprint probe IE2"; itype:8; icmp_seq:296; classtype:network-scan; priority:2; sid:1000310; rev:2;)

# ============================================================
# SOC DEKMA - NMAP OS FINGERPRINTING (-sV -p)
# Snort 2.9.20
# Destino protegido: 192.168.0.16
# ============================================================

alert tcp any any -> 192.168.0.16 80 (msg:"SOC DEKMA - Probable Nmap HTTP Service Version Detection -sV NSE"; flow:to_server,established; content:"Nmap Scripting Engine"; nocase; classtype:network-scan; priority:2; threshold:type limit,track by_src,count 1,seconds 5; sid:1000401; rev:2;)

alert tcp any any -> 192.168.0.16 80 (msg:"SOC DEKMA - Nmap HTTP Version Probe nmaplowercheck"; flow:to_server,established; content:"GET /nmaplowercheck"; nocase; classtype:network-scan; priority:2; threshold:type limit,track by_src,count 1,seconds 5; sid:1000402; rev:2;)

alert tcp any any -> 192.168.0.16 3389 (msg:"SOC DEKMA - Nmap RDP Service Version Detection -sV"; flow:to_server,established; content:"Cookie: mstshash=nmap"; nocase; classtype:network-scan; priority:2; threshold:type limit,track by_src,count 1,seconds 5; sid:1000403; rev:2;)
# ============================================================
# SOC DEKMA - NMAP OS FINGERPRINTING (-sU -p)
# Snort 2.9.20
# Destino protegido: 192.168.0.16
# ============================================================

alert udp any any -> 192.168.0.16 53 (msg:"STATE NMAP -sU DNS - version.bind"; content:"|00 06 01 00 00 01 00 00 00 00 00 00 07 76 65 72 73 69 6f 6e 04 62 69 6e 64 00 00 10 00 03|"; depth:30; dsize:30; flowbits:set,soc.nmap.su.dns1; flowbits:noalert; sid:1000501; rev:2;)
alert udp any any -> 192.168.0.16 53 (msg:"STATE NMAP -sU DNS - status probe"; content:"|00 00 10 00 00 00 00 00 00 00 00 00|"; depth:12; dsize:12; flowbits:isset,soc.nmap.su.dns1; flowbits:set,soc.nmap.su.dns2; flowbits:noalert; sid:1000502; rev:2;)
alert udp any any -> 192.168.0.16 53 (msg:"SOC DEKMA - Nmap UDP Scan -sU DNS probe sequence"; content:"|00 00 00 00 00 01 00 00 00 00 00 00 09 5f 73 65 72 76 69 63 65 73 07 5f 64 6e 73 2d 73 64 04 5f 75 64 70 05 6c 6f 63 61 6c 00 00 0c 00 01|"; depth:46; dsize:46; flowbits:isset,soc.nmap.su.dns1&soc.nmap.su.dns2; classtype:network-scan; priority:2; threshold:type limit,track by_src,count 1,seconds 10; sid:1000503; rev:2;)

alert udp any any -> 192.168.0.16 137 (msg:"DEBUG NMAP -sU - NetBIOS NBSTAT wildcard probe"; content:"CKAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"; offset:13; depth:32; content:"|00 00 21 00 01|"; distance:0; within:5; dsize:50; sid:1000504; rev:1;)
alert udp any any -> 192.168.0.16 161 (msg:"STATE NMAP -sU SNMP - SNMPv1 probe"; content:"|30 82 00 2f 02 01 00 04 06 70 75 62 6c 69 63 a0 82 00 20 02 04 4c 33 a7 56 02 01 00 02 01 00 30 82 00 10 30 82 00 0c 06 08 2b 06 01 02 01 01 05 00 05 00|"; depth:51; dsize:51; flowbits:set,soc.nmap.su.snmp1; flowbits:noalert; sid:1000505; rev:2;)
alert udp any any -> 192.168.0.16 161 (msg:"SOC DEKMA - Nmap UDP Scan -sU SNMP probe sequence"; content:"|30 3a 02 01 03 30 0f 02 02 4a 69 02 03 00 ff e3 04 01 04 02 01 03 04 10 30 0e 04 00 02 01 00 02 01 00 04 00 04 00 04 00 30 12 04 00 04 00 a0 0c 02 02 37 f0 02 01 00 02 01 00 30 00|"; depth:60; dsize:60; flowbits:isset,soc.nmap.su.snmp1; classtype:network-scan; priority:2; threshold:type limit,track by_src,count 1,seconds 10; sid:1000506; rev:2;)

alert udp any any -> 192.168.0.16 any (msg:"SOC DEKMA - Probable UDP Port Scan - Nmap -sU-like"; dsize:0; threshold:type both,track by_src,count 5,seconds 1; classtype:network-scan; priority:2; sid:1000507; rev:2;)

